{
    "name": "@hexlet/code",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "generate": "tsp compile typespec && openapi-ts",
        "start": "node --env-file-if-exists=.env src/server.ts",
        "predev": "npm run generate",
        "dev": "node --watch --env-file-if-exists=.env src/server.ts",
        "pretypecheck": "npm run generate",
        "typecheck": "tsc",
        "lint": "oxlint",
        "format": "oxfmt"
    },
    "dependencies": {
        "@fastify/static": "^10.1.5",
        "@hexlet/js-flight-booking-frontend": "^1.0.1",
        "better-sqlite3": "^13.0.3",
        "fastify": "^5.12.5",
        "fastify-openapi-glue": "^4.11.5",
        "kysely": "^0.29.6",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "^0.99.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.4",
        "@typespec/compiler": "^1.16.0",
        "@typespec/http": "^1.16.0",
        "@typespec/openapi3": "^1.16.0",
        "kysely-ctl": "^0.21.0",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=26"
    },
    "allowScripts": {
        "better-sqlite3": false
    }
}
